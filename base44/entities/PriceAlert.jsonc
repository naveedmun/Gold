{
  "name": "PriceAlert",
  "type": "object",
  "properties": {
    "metal": {
      "type": "string",
      "enum": [
        "gold",
        "silver"
      ]
    },
    "target_price": {
      "type": "number"
    },
    "direction": {
      "type": "string",
      "enum": [
        "above",
        "below"
      ]
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "triggered": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "metal",
    "target_price",
    "direction"
  ]
}